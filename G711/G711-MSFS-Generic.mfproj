        {
          "encoder": {
            "onLeft": {
              "Command": "(A:AUTOPILOT MANAGED SPEED IN MACH, Bool) if{ (>K:AP_MACH_VAR_DEC) } els{ (>K:AP_SPD_VAR_DEC) }",
              "PresetId": "0",
              "Type": "MSFS2020CustomInputAction"
            },
            "onLeftFast": {
              "Command": "(A:AUTOPILOT MANAGED SPEED IN MACH, Bool) if{ (A:AUTOPILOT MACH HOLD VAR, number) 0.05 - 0 max 100 * near (>K:AP_MACH_VAR_SET) } els{ (A:AUTOPILOT AIRSPEED HOLD VAR, knots) 10 - 0 max (>K:AP_SPD_VAR_SET) }",
              "PresetId": "0",
              "Type": "MSFS2020CustomInputAction"
            },
            "onRight": {
              "Command": "(A:AUTOPILOT MANAGED SPEED IN MACH, Bool) if{ (>K:AP_MACH_VAR_INC) } els{ (>K:AP_SPD_VAR_INC) }",
              "PresetId": "0",
              "Type": "MSFS2020CustomInputAction"
            },
            "onRightFast": {
              "Command": "(A:AUTOPILOT MANAGED SPEED IN MACH, Bool) if{ (A:AUTOPILOT MACH HOLD VAR, number) 0.05 + 0 max 100 * near (>K:AP_MACH_VAR_SET) } els{ (A:AUTOPILOT AIRSPEED HOLD VAR, knots) 10 + 0 max (>K:AP_SPD_VAR_SET) }",
              "PresetId": "0",
              "Type": "MSFS2020CustomInputAction"
            }
          },
