            },
            "onRight": {
              "Command": "(A:AUTOPILOT VERTICAL HOLD, Bool) if{ (>K:AP_VS_VAR_INC) } els{ (A:AUTOPILOT FLIGHT LEVEL CHANGE, Bool) if{ (A:AUTOPILOT MANAGED SPEED IN MACH, Bool) if{ (>K:AP_MACH_VAR_DEC) } els{ (>K:AP_SPD_VAR_DEC) } } els{ (>K:AP_PITCH_REF_INC_UP) } }",
              "PresetId": "0",
              "Type": "MSFS2020CustomInputAction"
            }
          },
