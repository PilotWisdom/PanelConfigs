          "encoder": {
            "onLeft": {
              "Command": "(A:AUTOPILOT VERTICAL HOLD, Bool) if{ (>K:AP_VS_VAR_DEC) } els{ (A:AUTOPILOT FLIGHT LEVEL CHANGE, Bool) if{ (A:AUTOPILOT MANAGED SPEED IN MACH, Bool) if{ (>K:AP_MACH_VAR_INC) } els{ (>K:AP_SPD_VAR_INC) } } els{ (>K:AP_PITCH_REF_INC_DN) } }",
